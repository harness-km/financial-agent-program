# Copy to .env and fill in. .env is gitignored and must stay that way.
# Nothing in weeks 1 to 3 needs a key — the cached data covers it.

# Your agent's own model calls, from week 4.
OPENAI_API_KEY=

# Web search, from week 10 (Part 2).
TAVILY_API_KEY=

# Optional: tracing, from week 7.
LANGSMITH_API_KEY=
LANGSMITH_TRACING=false

# Which model the agent uses. Keep this cheap while you are debugging.
FIN_AGENT_MODEL=gpt-5.4-mini
